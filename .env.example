# Development-only identity. Use fictional/local values here and never enable
# the local identity override in a production deployment.
CHIEF_OWNER_NAME=Local Owner
CHIEF_OWNER_EMAIL=owner@example.test
CHIEF_LOCAL_IDENTITY=false

# Live OpenAI synthesis. Keep secrets in .env locally and Sites secrets in production.
OPENAI_API_KEY=
MODEL_REASONING=gpt-5.6-sol
MODEL_FAST=gpt-5.6-luna
MODEL_EXTRACTION=gpt-5.6-terra
MODEL_EMBEDDING=text-embedding-3-small
MODEL_TRANSCRIPTION=gpt-transcribe
MODEL_MAX_TURNS=4
MODEL_MAX_TOOL_CALLS=6
MODEL_TIMEOUT_MS=45000
MODEL_DAILY_BUDGET_USD=5
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live Google OAuth. Create a Web application OAuth client and enable Gmail + Calendar APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/google/callback

# Live Microsoft 365 OAuth. Register a Web app in Microsoft Entra ID.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use your organization tenant ID for strict single-tenant authorization.
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/connections/microsoft/callback
# Use a long random value (for example: openssl rand -base64 48).
TOKEN_ENCRYPTION_KEY=
